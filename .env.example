# =============================================================================
# 1. WISPBYTE PANEL / UNIFIED HTTP DASHBOARD & BLUXMART.COM CLOUD SYNC
# =============================================================================
# Note: Wispbyte automatically injects SERVER_PORT; PORT is used as fallback
PORT=9843
BLUXMART_SITE_URL=https://bluxmart.com
WISP_BOT_SECRET=bluxmart-wisp-secret-2026

# =============================================================================
# 2. DISCORD BOT SETTINGS (Bluxbot Server Management, Tickets, Reviews)
# =============================================================================
# You can set these here OR configure them live in the Web Dashboard -> Discord Bot tab!
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
DATA_DIR=./data
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3001
DASHBOARD_USER=admin
DASHBOARD_PASS=admin123456

# =============================================================================
# 3. MINECRAFT BOT & DONUTSMP AUTO-DELIVERY SETTINGS
# =============================================================================
MC_SERVER_HOST=donutsmp.net
MC_SERVER_PORT=25565
MC_VERSION=1.20.4
MC_AUTH_TYPE=microsoft
SAFE_RETURN_COMMAND=/home
SAFETY_RADIUS_BLOCKS=5
TPA_WAIT_TIMEOUT_MS=45000
MAX_DELIVERY_RETRIES=5
